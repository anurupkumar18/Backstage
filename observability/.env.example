# Collector-only. Never expose these to the browser or commit real values.
# Copy endpoint (host:port for OTLP/gRPC) and token from Dash0 onboarding.
DASH0_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=
DASH0_DATASET=default
# Web origin allowed to POST browser spans to :4318 (one origin).
OTEL_CORS_ALLOWED_ORIGIN=http://localhost:5173
